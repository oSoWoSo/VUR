# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.7.0
revision=1
build_style=cmake
configure_args="--no-warn-unused-cli -DDISABLE_TESTS=ON -DCMAKE_BUILD_TYPE:STRING=Release"
hostmakedepends="pkg-config hyprwayland-scanner hicolor-icon-theme wayland-devel"
makedepends="abseil-cpp-devel aquamarine-devel cairo-devel file-devel hyprgraphics
 hyprlang hyprutils-devel iniparser-devel libdrm-devel libgbm-devel libglvnd-devel
 libheif-devel libjpeg-turbo-devel libjxl-devel libpng-devel librsvg-devel
 libwebp-devel libxkbcommon-devel pango-devel pixman-devel wayland-devel
 wayland-protocols"
depends="wayland"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="zenobit <zen@osowoso.org>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
distfiles="https://github.com/hyprwm/hyprtoolkit/archive/refs/tags/v${version}.tar.gz"
checksum=7dc82a531537fd068f51110fa49c4cab01f3419d9e2cb8c2c2f2e8c49e26bcde
make_check=no # cant run in sandbox

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision} wayland-devel wayland-protocols libglvnd-devel"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
	}
}
