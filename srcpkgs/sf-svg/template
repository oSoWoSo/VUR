# Template file for 'sf-svg'
pkgname=sf-svg
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="qt6-declarative-devel qt6-svg-devel sf-archive-devel sf-color-scheme-devel sf-core-addons-devel sf-quick-ui-devel sf-settings-devel"
short_desc="Library for rendering SVG-based themes"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-svg"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-svg/archive/refs/tags/${version}.tar.gz"
checksum=f691a555307f48f020c272480b75edde3f527457fbb1b0187bfbaf2347576f64

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-svg-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
