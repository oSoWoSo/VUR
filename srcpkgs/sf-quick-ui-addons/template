sf-quick-ui-addons-devel_package() {
	provides="kirigami-addons-devel-${version}_${revision}"
	conflicts="kirigami-addons-devel"
	replaces="kirigami-addons-devel>=0"
	depends="${sourcepkg}-${version}_${revision} qt6-base-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
