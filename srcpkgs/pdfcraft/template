# Template file for 'pdfcraft'
pkgname=pdfcraft
version=0.13.0
revision=1
build_style=cargo
make_build_args="-p pdfcraft -p pdfcraft-cli"
hostmakedepends="pkg-config"
# makedepends="fontconfig-devel freetype-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel libxkbcommon-devel wayland-devel"
short_desc="PDF reader and editor written by scratch in pure Rust"
maintainer="zenobit <zen@osowoso.org>"
license="Apache-2.0, MIT"
homepage="https://github.com/storytold/pdfcraft"
distfiles="https://github.com/storytold/pdfcraft/archive/refs/tags/v${version}.tar.gz
 https://ocrs-models.s3-accelerate.amazonaws.com/text-detection.rten>text-detection.rten
 https://ocrs-models.s3-accelerate.amazonaws.com/text-recognition.rten>text-recognition.rten
 https://creativecommons.org/licenses/by-sa/4.0/legalcode.txt>LICENSE-OCRS-MODELS"

checksum="a65214953787fd8428cb6636447a0e65a66f20bb64ace18bb58e06d7002d7a5b
 f15cfb56bd02c4bf478a20343986504a1f01e1665c2b3a0ad66340f054b1b5ca
 e484866d4cce403175bd8d00b128feb08ab42e208de30e42cd9889d8f1735a6e
