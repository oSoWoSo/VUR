# Instruct XBPS-src to copy these files directly without attempting to uncompress them
skip_extraction="text-detection.rten text-recognition.rten LICENSE-OCRS-MODELS"

do_install() {
	# 1. Install application for Desktop and command line (CLI)
	vbin target/${RUST_TARGET}/release/pdfcraft
	vbin target/${RUST_TARGET}/release/pdfcraft-cli

	# 2. Install shortcut in menu (.desktop) and mime types
	vinstall packaging/linux/ai.storyteller.pdfcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.pdfcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.pdfcraft.xml
	vinstall packaging/linux/ai.storyteller.pdfcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.pdfcraft.metainfo.xml

	# 3. Iterate icons and install
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.pdfcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.pdfcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.pdfcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.pdfcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install pre-fetched RTEN OCR neural models securely into the package share structure
	vmkdir usr/share/pdfcraft/models
	vinstall ${XBPS_SRCDISTDIR}/${pkgname}-${version}/text-detection.rten 644 usr/share/pdfcraft/models
	vinstall ${XBPS_SRCDISTDIR}/${pkgname}-${version}/text-recognition.rten 644 usr/share/pdfcraft/models

	# 5. Install licenses and legal NOTICE
	vlicense ${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE-OCRS-MODELS
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 6. Technical documentation in Markdown
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
