# Template file for 'sf-image-formats'
pkgname=sf-image-formats
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKIMAGEFORMATS_HEIF=ON -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="pkg-config qt6-base qt6-tools sf-cmake-modules sonic-namespace"
makedepends="libavif-devel libheif-devel libjxl-devel libopenexr-devel libraw-devel sf-archive-devel"
short_desc="Plugins to allow QImage to support extra file formats"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-image-formats"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-image-formats/archive/refs/tags/${version}.tar.gz"
checksum=01645074425dec983aa0e28673e5ed88845f5487b918adfa7a1b207831f9ed14

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	exclude="kimageformats-read-xcf|kimageformats-read-psd|kimageformats-read-hej2|kimageformats-read-heif|kimageformats-write-hej2"
	case "$XBPS_TARGET_MACHINE" in
		i686*) exclude+="|kimageformats-write-exr";;
		*) ;;
	esac

	# disable failing tests
	ctest -E "$exclude"
}
