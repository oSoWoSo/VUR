# Template file for 'sonic-quick-image-editor'
pkgname=sonic-quick-image-editor
version=0.7.0.1
revision=1
build_style=cmake
configure_args="-DBUILD_WITH_QT6=ON -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="AppStream-devel highway-devel libopencv-devel qt6-base-devel qt6-declarative-devel qt6-shadertools-devel sf-settings-devel"
short_desc="QtQuick-based image editing components"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-quick-image-editor"
distfiles="https://github.com/Sonic-DE/sonic-quick-image-editor/archive/refs/tags/${version}.tar.gz"
checksum=ac92df06d7c938783d795de793c68d0e3baf7567977b46afa7dcc0070857dc54
provides="kquickimageeditor-${version}_${revision}"
conflicts="kquickimageeditor"
replaces="kquickimageeditor>=0"

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sonic-quick-image-editor-devel_package() {
	provides="kquickimageeditor-devel-${version}_${revision}"
	conflicts="kquickimageeditor-devel"
	replaces="kquickimageeditor-devel>=0"
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/qt6/mkspecs
	}
}
