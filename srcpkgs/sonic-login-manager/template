# Template file for 'sonic-login-manager'
pkgname=sonic-login-manager
version=6.8.0.3
revision=1
build_style=cmake
configure_args=" -DKDE_INSTALL_LIBEXECDIR=libexec -DSPLIT_BUILD=ON
 -DINSTALL_PAM_CONFIGURATION=OFF -DX_SERVER_EXECUTABLE=/usr/libexec/Xorg
 -DDBUS_CONFIG_FILENAME=plasma_org.freedesktop.DisplayManager.conf
 -DCMAKE_INSTALL_FULL_SYSCONFDIR=/etc -DCMAKE_INSTALL_SYSCONFDIR=/etc"
hostmakedepends="gettext pkg-config qt6-base qt6-shadertools qt6-tools
 sf-cmake-modules sonic-namespace xorg-server"
makedepends="layer-shell-qt-devel libcap-devel libXau-devel pam-devel
 qt6-base-private-devel qt6-declarative-devel qt6-qt5compat-devel
 qt6-shadertools-devel sf-app-info-devel sf-auth-devel sf-core-addons-devel
 sf-dbus-devel sf-icon-themes-devel sf-internationalization-devel sf-io-devel
 sf-package-devel sf-quick-ui-devel sf-settings-devel sf-settings-utils-devel
 sf-windowsystem-devel sonic-interface-libraries-devel
 sonic-screen-library-devel sonic-workspace-devel xorg-server-devel"
depends="libelogind"
short_desc="Sonic Login Manager"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-2.0-or-later"
homepage="https://github.com/Sonic-DE/sonic-login-manager"
distfiles="https://github.com/Sonic-DE/sonic-login-manager/archive/refs/tags/${version}.tar.gz"
checksum=d0b6e6598ae3dfa864474594021fa010a3c03b16df34c48ec60e0c80cdaf10ea
provides="plasma-login-manager-${version}_${revision}"
system_groups="soniclogin"
system_accounts="_soniclogin"
soniclogin_pgroup="soniclogin"
make_dirs="/var/log/sonic 0755 root root
 /run/soniclogin 0711 soniclogin soniclogin"

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

post_install() {
	if [ -d "${DESTDIR}/usr/etc" ]; then
		vmkdir etc
		cp -a "${DESTDIR}/usr/etc/." "${DESTDIR}/etc/"
		rm -rf "${DESTDIR}/usr/etc"
	fi
	rm -rf ${DESTDIR}/etc/dinit.d
	rm -rf ${DESTDIR}/etc/init.d
	rm -rf ${DESTDIR}/etc/runit
	rm -rf ${DESTDIR}/etc/s6
	rm -rf ${DESTDIR}/etc/logrotate.d
	vsv soniclogin
}
