# Template file for 'sonic-system-monitor-library'
pkgname=sonic-system-monitor-library
version=6.8.0
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF -DSF6_HOST_TOOLING=/usr/lib/cmake
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_LIBEXECDIR=libexec"
hostmakedepends="sf-cmake-modules gettext pkg-config libcap-progs
 qt6-tools qt6-base qt6-declarative-host-tools sf-package sf-settings
 sf-auth-tools sonic-namespace"
makedepends="qt6-base-devel qt6-declarative-devel qt6-webchannel-devel
 sf-settings-devel sf-internationalization-devel sf-auth-devel sf-app-info-devel
 sf-package-devel sf-addons-downloader-devel sf-device-integration-devel libpcap-devel
 libcap-devel libnl3-devel libsensors-devel libdrm-devel zlib-devel
 qt6-base-private-devel sf-core-addons-devel"
short_desc="Library to retrieve info on the current status of computer hardware"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-or-later"
homepage="https://github.com/Sonic-DE/sonic-system-monitor-library"
distfiles="https://github.com/Sonic-DE/sonic-system-monitor-library/archive/refs/tags/${version}.tar.gz"
