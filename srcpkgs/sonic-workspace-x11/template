 qt6-position-devel qt6-qt5compat-devel qt6-shadertools-devel qt6-svg-devel
 qt6-tools-devel qt6-virtualkeyboard-devel sf-addons-downloader-devel
 sf-app-info-devel sf-archive-devel sf-auth-devel sf-autocomplete-devel
 sf-barcode-devel sf-bookmarks-devel sf-color-scheme-devel sf-core-addons-devel
 sf-crash-handler-devel sf-data-models-devel sf-dbus-devel
 sf-device-integration-devel sf-doctools-devel sf-file-search-devel
 sf-gui-addons-devel sf-holidays-devel sf-icon-themes-devel sf-idle-tracker-devel
 sf-internationalization-devel sf-io-devel sf-keybind-devel sf-keyring-devel
 sf-networkmanager-devel sf-notification-settings-devel sf-notifications-devel
 sf-package-devel sf-progress-ui-devel sf-qml-bridge-devel sf-quick-charts-devel
 sf-quick-ui-addons-devel sf-quick-ui-devel sf-root-shell-devel sf-runner-devel
 sf-settings-devel sf-settings-ui-devel sf-settings-utils-devel
 sf-status-notification-devel sf-svg-devel sf-text-editor-devel
 sf-text-widgets-devel sf-ui-components-devel sf-unit-conversion-devel
 sf-user-feedback-devel sf-widgets-addons-devel sf-windowsystem-devel
 sf-xml-gui-devel sonic-activities-devel sonic-activities-stats-devel
 sonic-daemon-devel sonic-exiv2-library-devel sonic-interface-libraries-devel
 sonic-night-light-devel sonic-pipewire-devel sonic-plasma5-support-library-devel
 sonic-polkit-devel sonic-screen-library-devel sonic-screenlocker-devel
