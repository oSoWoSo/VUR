# Template file for 'sonic-workspace'
pkgname=sonic-workspace
version=6.8.0.4
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DGLIBC_LOCALE_GEN=OFF -DKDE_INSTALL_LIBEXECDIR=libexec
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins -DSF6_HOST_TOOLING=/usr/lib/cmake"
hostmakedepends="gettext iso-codes pkg-config qt6-base qt6-declarative-host-tools
 qt6-shadertools qt6-tools sf-auth-tools sf-cmake-modules sf-doctools sf-package
 sf-settings sf-settings-utils sf-windowsystem sonic-namespace SPIRV-Tools"
makedepends="accountsservice-devel AppStream-qt-devel dbus-devel elogind-devel
 eudev-libudev-devel fontconfig-devel freetype-devel icu-devel libcanberra-devel
 libglib-devel libgomp-devel libICE-devel libqalculate-devel libSM-devel
