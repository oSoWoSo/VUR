build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_LIBEXECDIR=libexec"
hostmakedepends="gettext pkg-config qt6-base qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="libnl3-devel libsensors-devel sf-crash-handler-devel sf-dbus-devel sf-device-integration-devel sf-io-devel sf-networkmanager-devel sonic-system-monitor-library-devel"
short_desc="Plugin based system monitoring daemon"
