# Template file for 'sonic-activities-stats'
pkgname=sonic-activities-stats
version=6.8.0
revision=1
build_style=cmake
hostmakedepends="qt6-base qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="boost-headers sf-core-addons-devel sf-settings-devel sonic-activities-devel"
short_desc="Library for accessing the usage data collected by the activities system"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-or-later"
homepage="https://github.com/Sonic-DE/sonic-activities-stats"
distfiles="https://github.com/Sonic-DE/sonic-activities-stats/archive/refs/tags/${version}.tar.gz"
checksum=57dfdb36c3410b89da143df982579a0f50a394b03de9408687083383991b89a8
provides="plasma-activities-stats-${version}_${revision}"
conflicts="plasma-activities-stats"
replaces="plasma-activities-stats>=0"

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# disable failing tests
	ctest -E "PlasmaActivitiesStatsTest"
}

sonic-activities-stats-devel_package() {
	provides="plasma-activities-stats-devel-${version}_${revision}"
	conflicts="plasma-activities-stats-devel"
	replaces="plasma-activities-stats-devel>=0"
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
