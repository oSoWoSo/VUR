# Template file for 'sf-data-models'
pkgname=sf-data-models
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sonic-namespace"
makedepends="qt6-declarative-devel"
short_desc="Item models extending the Qt model-view framework"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-data-models"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-data-models/archive/refs/tags/${version}.tar.gz"
checksum=fa825205e659fd1061f325407d9d6736f000243d7d139048633e7a6297632fb7

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-data-models-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
