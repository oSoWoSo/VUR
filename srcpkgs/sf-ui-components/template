# Template file for 'sf-ui-components'
pkgname=sf-ui-components
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="gettext qt6-base qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="sf-core-addons-devel sf-internationalization-devel sf-io-devel sf-settings-devel sf-xml-gui-devel"
short_desc="Plugin framework for user interface components"
maintainer="zenobit <zen@osowoso.org>"
