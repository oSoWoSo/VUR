 qt6-base-private-devel libxkbcommon-devel sf-internationalization-devel sf-settings-devel sf-xml-gui-devel
 sf-widgets-addons-devel libX11-devel libXext-devel sf-notifications-devel libICE-devel
 sf-dbus-devel sonic-plasma5-support-library-devel libxcb-devel sf-settings-utils-devel sf-package-devel
 sonic-workspace-devel sf-core-addons-devel sonic-interface-libraries-devel
