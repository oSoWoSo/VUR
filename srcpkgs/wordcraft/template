# Template file for 'wordcraft'
pkgname=wordcraft
version=0.6.1
revision=1
build_style=cargo
make_build_args="-p wordcraft -p wordcraft-cli"
hostmakedepends="pkg-config"
# makedepends="fontconfig-devel freetype-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel libxkbcommon-devel wayland-devel"
short_desc="Clean-room reimplementation of Microsoft Word in pure Rust"
maintainer="zenobit <zen@osowoso.org>"
license="Apache-2.0, MIT"
homepage="https://github.com/storytold/wordcraft"
distfiles="https://github.com/storytold/wordcraft/archive/refs/tags/v${version}.tar.gz"
checksum=da04df66c0637b7fd9d8b1b0079f8cf91aa8a04dec12fa5426adaca386945a88

do_install() {
	# 1. Install application binaries directly from target release (prevents double compilation)
	vbin target/${RUST_TARGET}/release/wordcraft
	vbin target/${RUST_TARGET}/release/wordcraft-cli

	# 2. Install desktop shortcut, appstream metadata, and custom mime types from upstream packaging
	if [ -d "packaging/linux" ]; then
		vinstall packaging/linux/ai.storyteller.wordcraft.desktop 644 usr/share/applications
		vinstall packaging/linux/ai.storyteller.wordcraft.mime.xml 644 usr/share/mime/packages ai.storyteller.wordcraft.xml
		vinstall packaging/linux/ai.storyteller.wordcraft.metainfo.xml.in 644 usr/share/metainfo ai.storyteller.wordcraft.metainfo.xml
	fi

	# 3. Iterate over the standard hicolor icon paths and install them with the proper app ID name
	local size
	for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		if [ -f "assets/app-icon/hicolor/${size}/apps/ai.storyteller.wordcraft.png" ]; then
			vinstall "assets/app-icon/hicolor/${size}/apps/ai.storyteller.wordcraft.png" \
				644 "usr/share/icons/hicolor/${size}/apps"
		fi
	done

	if [ -f "assets/app-icon/hicolor/scalable/apps/ai.storyteller.wordcraft.svg" ]; then
		vinstall "assets/app-icon/hicolor/scalable/apps/ai.storyteller.wordcraft.svg" \
			644 "usr/share/icons/hicolor/scalable/apps"
	fi

	# 4. Install standard software licenses and the legal NOTICE file
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
	if [ -f "NOTICE" ]; then
		vlicense NOTICE
	fi

	# 5. Extract and bundle technical Markdown documentation
	if [ -d "docs" ]; then
		local docfile
		for docfile in docs/*.md; do
			if [ -f "$docfile" ]; then
				vdoc "$docfile"
			fi
		done
	fi
}
