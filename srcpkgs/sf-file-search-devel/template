# Template file for 'sf-file-search'
pkgname=sf-file-search
version=6.31.0
revision=1
build_style=cmake
configure_args="-DSF6_HOST_TOOLING=/usr/lib/cmake
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_LIBEXECDIR=libexec"
hostmakedepends="gettext qt6-base qt6-declarative-host-tools qt6-tools
 sf-cmake-modules sf-settings-devel sonic-namespace"
makedepends="lmdb-devel qt6-declarative-devel sf-core-addons-devel
 sf-crash-handler-devel sf-dbus-devel sf-device-integration-devel
 sf-file-metadata-devel sf-idle-tracker-devel
 sf-internationalization-devel sf-io-devel sf-settings-devel"
short_desc="Framework for searching and managing metadata"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-file-search"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-file-search/archive/refs/tags/${version}.tar.gz"
checksum=ae80d7edba8b2cc0b8a82eabcd862cf7bc41e76d9a0acee82c872d121f9e33bc

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# disable failing text
	ctest -E "(filemonitortest|filewatchtest)"
}

sf-file-search-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
