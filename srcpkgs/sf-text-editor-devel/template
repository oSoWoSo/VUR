# Template file for 'sf-text-editor'
pkgname=sf-text-editor
version=6.31.0
revision=1
build_style=cmake
configure_args="-DSF6_HOST_TOOLING=/usr/lib/cmake
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="gettext qt6-base qt6-declarative-host-tools qt6-tools sf-auth-tools
 sf-cmake-modules sf-settings sonic-namespace"
makedepends="editorconfig-devel qt6-multimedia-devel qt6-speech-devel
 qt6-speech-plugin-flite qt6-speech-plugin-mock qt6-speech-plugin-speechd
 sf-archive-devel sf-auth-devel sf-gui-addons-devel sf-internationalization-devel
 sf-io-devel sf-settings-devel sf-spell-check-devel sf-syntax-highlighting-devel
 sf-text-widgets-devel sf-ui-components-devel sf-xml-gui-devel"
short_desc="Full text editor component"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-text-editor"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-text-editor/archive/refs/tags/${version}.tar.gz"
checksum=b0ed0a0ca055e15fa222f38fde38d8b049c40e640d04490037fb072b64992c58

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-text-editor-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
