configure_args="-DBUILD_TESTING=OFF -DFORCE_CROSSCOMPILED_TOOLS=ON
 -DSF6_HOST_TOOLING=/usr/lib/cmake -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_LIBEXECDIR=libexec"
hostmakedepends="python3 gettext pkg-config libcap-progs qt6-base qt6-tools
 qt6-declarative-host-tools sf-package sf-settings sf-settings-utils
 sf-windowsystem sf-auth-tools sf-doctools sf-cmake-modules sonic-namespace"
makedepends="sf-settings-utils-devel sf-color-scheme-devel sf-settings-devel
 sf-crash-handler-devel sf-qml-bridge-devel sf-internationalization-devel
 sf-data-models-devel sf-addons-downloader-devel sf-notifications-devel
 sf-package-devel sf-quick-charts-devel sf-app-info-devel sf-svg-devel
 sf-widgets-addons-devel sf-xml-gui-devel lcms2-devel libcanberra-devel
 libdisplay-info-devel libdrm-devel libepoxy-devel libqaccessibilityclient-devel
 libX11-devel libxcb-devel libXi-devel libxkbcommon-devel qt6-qt5compat-devel
 qt6-base-private-devel qt6-declarative-devel qt6-sensors-devel qt6-svg-devel
 qt6-tools-devel sonic-decoration-devel sf-idle-tracker-devel sf-dbus-devel
 sf-settings-ui-devel sonic-activities-devel sf-auth-devel sf-core-addons-devel
 sf-gui-addons-devel sf-keybind-devel sf-quick-ui-devel sf-windowsystem-devel
