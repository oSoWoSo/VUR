# Template file for 'sonic-pipewire'
pkgname=sonic-pipewire
version=6.8.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml"
hostmakedepends="gettext pipewire pkg-config plasma-wayland-protocols qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sonic-namespace"
makedepends="ffmpeg6-devel libepoxy-devel libva-devel pipewire-devel qt6-base-private-devel qt6-declarative-devel sf-core-addons-devel sf-internationalization-devel"
depends="pipewire"
short_desc="Components to use PipeWire in Qt projects"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/Sonic-DE/sonic-pipewire"
distfiles="https://github.com/Sonic-DE/sonic-pipewire/archive/refs/tags/${version}.tar.gz"
checksum=d062fb8b84b25fba8e6f52a6d1876118bf8ac7961972fa037f038eddc27767dc
provides="kpipewire-${version}_${revision}"
conflicts="kpipewire"
replaces="kpipewire>=0"

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	ctest -E "mediamonitortest|TestEncoder"
}

sonic-pipewire-devel_package() {
	provides="kpipewire-devel-${version}_${revision}"
	conflicts="kpipewire-devel"
	replaces="kpipewire-devel>=0"
	depends="${sourcepkg}>=${version}_${revision} pipewire-devel qt6-base-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
