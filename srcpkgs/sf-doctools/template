# Template file for 'sf-doctools'
pkgname=sf-doctools
version=6.31.0
revision=1
build_style=cmake
build_helper=qemu
hostmakedepends="sonic-namespace doxygen docbook-xml docbook-xsl qt6-tools qt6-base gettext perl perl-URI sf-cmake-modules"
makedepends="libstdc++-devel libxml2-devel libxslt-devel sf-archive-devel sf-internationalization-devel qt6-base-devel"
depends="docbook-xml docbook-xsl"
short_desc="DocBook-based documentation generation tools for SonicDE frameworks"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-only OR LGPL-3.0-only"
homepage="https://github.com/Sonic-DE/sonic-frameworks-doctools"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-doctools/archive/refs/tags/${version}.tar.gz"
checksum=5aa6352150a4ca25729512d4038df19b8dbd0de1c4b9d32d0efb5e678fcfcde8

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}



sf-doctools-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		mkdir -p "${DESTDIR}/usr/lib/cmake/SF6DocTools"
		mv ${PKGDESTDIR}/usr/lib/cmake/SF6DocTools/SF6DocToolsTools* \
			"${DESTDIR}/usr/lib/cmake/SF6DocTools"
		vmove "usr/lib/*.so"
	}
}
