replaces="dolphin>=0"

if [ "$CROSS_BUILD" ]; then
	LDFLAGS=" -Wl,-rpath-link,../bin"
fi

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	LDFLAGS="$LDFLAGS -Wl,-z,stack-size=0x200000"
	makedepends+=" musl-fts-devel"
fi

post_patch() {
