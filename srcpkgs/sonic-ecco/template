 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="sf-cmake-modules python3 qt6-tools qt6-base
 gettext sf-core-addons sf-settings sf-doctools
 sf-settings-utils sonic-namespace"
makedepends="sf-file-search-devel sf-bookmarks-devel
 sf-settings-utils-devel sf-autocomplete-devel
 sf-settings-devel sf-core-addons-devel
 sf-crash-handler-devel sf-dbus-devel
 sf-doctools-devel sf-file-metadata-devel
 sf-internationalization-devel sf-icon-themes-devel
 sf-io-devel sf-addons-downloader-devel
 sf-notifications-devel sf-ui-components-devel
 sf-text-widgets-devel sf-user-feedback-devel
 sf-windowsystem-devel sf-device-integration-devel
 qt6-base-private-devel baloo-widgets-devel phonon-devel sonic-activities-devel"
depends="sf-io-extras"
short_desc="File manager for Sonic"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-2.0-or-later OR GFDL-1.2-or-later"
