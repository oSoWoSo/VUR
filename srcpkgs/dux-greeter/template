# Template file for 'dux-greeter'
pkgname=dux-greeter
version=2.1.0
revision=1
build_wrksrc="core"
build_style=go
build_helper=qemu
go_import_path="github.com/duxlabs-dev/dux-greeter/core"
go_package="${go_import_path}/cmd/dms-greeter"
go_build_tags="withshell"
go_ldflags="-X main.Version=${version}"
hostmakedepends="dux-qml-common make tar"
short_desc="Greetd login screen with the Dux Shell aesthetic"
maintainer="zenobit <zen@osowoso.org>"
license="MIT"
homepage="https://github.com/duxlabs-dev/dux-greeter"
changelog="https://github.com/duxlabs-dev/dux-greeter/releases"
distfiles="https://github.com/duxlabs-dev/dux-greeter/archive/refs/tags/v${version}.tar.gz"
checksum=8efaf6e7dcba5b6ac35f7e3847ee4b65fec2099e0f2f224a479cccc97e56924e

conflicts="dux-greeter-git"
replaces="dms-greeter>=0"
provides="dms-greeter-${version}_${revision}"

depends="greetd quickshell acl-progs dbus elogind pam_rundir mesa-dri"

# Cache dir the greeter uses as $HOME (owned by greetd's _greeter user);
# also holds the extracted embedded UI.
make_dirs="/var/cache/dms-greeter 0750 _greeter _greeter"

pre_configure() {
	# Use the packaged common QML assets instead of a bundled submodule
	rm -f ../quickshell/DCommon
	ln -s /usr/share/dux-qml-common/DCommon ../quickshell/DCommon
}

pre_build() {
	# Bake the quickshell UI into the embed dir consumed by go:embed
	make sync-shell
}

post_install() {
	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/dms-greeter completion ${shell} > dms-greeter.${shell}
		vcompletion dms-greeter.${shell} ${shell}
	done

	vmkdir usr/share/examples/dms-greeter
	vcopy ../assets/examples/* usr/share/examples/dms-greeter

	vlicense ../LICENSE
	vdoc ../README.md
}
