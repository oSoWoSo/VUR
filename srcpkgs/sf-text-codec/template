# Template file for 'sf-text-codec'
pkgname=sf-text-codec
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="sonic-namespace sf-cmake-modules qt6-tools qt6-base gperf"
makedepends="qt6-base-devel"
short_desc="Collection of methods to manipulate strings using various encodings"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-text-codec"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-text-codec/archive/refs/tags/${version}.tar.gz"
checksum=4817963dbc7350a7902fd2af46583b8ce3397499e09913dc90a39e23aa069b2e

sf-text-codec-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}
