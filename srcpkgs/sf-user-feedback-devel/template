# Template file for 'sf-user-feedback'
pkgname=sf-user-feedback
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="bison flex qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sonic-namespace"
makedepends="qt6-base-devel qt6-charts-devel qt6-declarative-devel"
short_desc="Framework for collecting user feedback via telemetry and surveys"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-user-feedback"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-user-feedback/archive/refs/tags/${version}.tar.gz"
checksum=bf40e82c34536d05de42725038b17453b52a203b3c90765d5ee6c79df3618498

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# disable failing test
	ctest -E "openglinfosourcetest|providertest"
}

sf-user-feedback-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
