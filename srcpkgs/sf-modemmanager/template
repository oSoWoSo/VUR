# Template file for 'sf-modemmanager'
pkgname=sf-modemmanager
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="pkg-config qt6-base qt6-tools sf-cmake-modules sonic-namespace"
makedepends="ModemManager-devel qt6-base-devel"
checkdepends="dbus"
short_desc="Qt wrapper for ModemManager DBus API"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-modemmanager"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-modemmanager/archive/refs/tags/${version}.tar.gz"
checksum=fec4762013ea060bbcd2d9d57e673b96ff3de415994d45a7912fae313d7aaf83

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	dbus-run-session ctest
}

sf-modemmanager-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
