# Template file for 'sf-icon-themes'
pkgname=sf-icon-themes
version=6.31.0.1
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="gettext qt6-base qt6-declarative-host-tools qt6-tools
 sf-cmake-modules sf-settings sonic-namespace"
makedepends="qt6-base-private-devel qt6-svg-devel sf-archive-devel
 sf-color-scheme-devel sf-internationalization-devel sf-settings-ui-devel
 sf-silver-icons-library-devel sf-widgets-addons-devel"
short_desc="Icon GUI utilities"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-icon-themes"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-icon-themes/archive/refs/tags/${version}.tar.gz"
checksum=efff90128665a5fe43cab271d68f605d26a354cd492e68a990d25c83be77fc81

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	# kiconengine_unittest::testMode compares against a hardcoded pixel color
	# that assumes the original KDE test icon geometry; the Sonic-DE silver
	# icon has different geometry, so those assertions are not applicable.
	cd build
	ctest -E kiconengine_unittest
}

sf-icon-themes-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel qt6-declarative-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
