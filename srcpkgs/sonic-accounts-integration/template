# Template file for 'sonic-accounts-integration'
pkgname=sonic-accounts-integration
version=26.08.2
revision=1
build_style=cmake
configure_args="-DKF6_HOST_TOOLING=/usr/lib/cmake
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="gettext pkg-config qt6-base qt6-declarative-host-tools sf-cmake-modules sf-package sf-settings-utils sonic-namespace"
makedepends="libaccounts-qt6-devel qcoro-qt6-devel qt6-base-devel qt6-declarative-devel sf-core-addons-devel sf-dbus-devel sf-internationalization-devel sf-keyring-devel sf-settings-utils-devel sf-ui-components-devel signond-devel"
depends="signon-plugin-oauth2 signon-kwallet-extension"
short_desc="Online account management system and its Sonic integration components"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-or-later"
homepage="https://github.com/Sonic-DE/sonic-accounts-integration"
distfiles="https://github.com/Sonic-DE/sonic-accounts-integration/archive/refs/tags/${version}.tar.gz"
checksum=7a40aa20c7a18516bd6f5bf46936075d9968f3b64366561d5e252a933b747e9e

# depends on webengine
if [ "$XBPS_WORDSIZE$XBPS_WORDSIZE" = "64$XBPS_TARGET_WORDSIZE" ]; then
	depends+=" signon-ui"
fi

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sonic-accounts-integration-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision} libaccounts-qt6-devel qt6-base-devel sf-core-addons-devel signond-devel"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
