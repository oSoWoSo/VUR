# Template file for 'sonic-terminal-tools'
pkgname=sonic-terminal-tools
version=6.8.0
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF -DSF6_HOST_TOOLING=/usr/lib/cmake
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_LIBEXECDIR=libexec"
hostmakedepends="sf-cmake-modules qt6-base qt6-tools gettext
 sf-windowsystem sf-settings sf-settings-utils sf-doctools sonic-namespace"
makedepends="sonic-activities-devel sf-settings-utils-devel sf-root-shell-devel
 qt6-svg-devel sf-settings-devel sf-icon-themes-devel sf-io-devel
 sf-app-info-devel sf-windowsystem-devel sf-ui-components-devel
 sf-core-addons-devel sf-widgets-addons-devel sf-doctools-devel
 sonic-workspace-devel sf-internationalization-devel qt6-base-private-devel"
depends="xdg-utils"
short_desc="Tools based on Sonic Frameworks to better interact with the system"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
