# Template file for 'sf-file-metadata'
pkgname=sf-file-metadata
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="gettext pkg-config qt6-base qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="attr-devel ebook-tools-devel exiv2-devel ffmpeg6-devel libqmobipocket6-devel poppler-qt6-devel qt6-base-devel sf-archive-devel sf-core-addons-devel sf-internationalization-devel sf-settings-devel sf-text-codec-devel taglib-devel"
short_desc="Library for extracting file metadata"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-file-metadata"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-file-metadata/archive/refs/tags/${version}.tar.gz"
checksum=cab416de326aa64c0ff77f7198fc361db5337ec545732b79b9924ea9a9421b8e

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# Skip failing tests
	ctest -E "usermetadatawritertest"
}

sf-file-metadata-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
