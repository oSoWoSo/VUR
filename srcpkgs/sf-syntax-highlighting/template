# Template file for 'sf-syntax-highlighting'
pkgname=sf-syntax-highlighting
version=6.31.0
revision=1
build_style=cmake
configure_args="
 -DKATEHIGHLIGHTINGINDEXER_EXECUTABLE=/usr/libexec/kate/katehighlightingindexer
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="perl qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sonic-namespace"
makedepends="libxerces-c-devel qt6-base-devel qt6-declarative-devel"
short_desc="Syntax highlighting Engine for Structured Text and Code"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-syntax-highlighting"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-syntax-highlighting/archive/refs/tags/${version}.tar.gz"
checksum=7f4fae2e60d203de1fd24a77c709073bad2407aa7c198154a263c6caea6fcd91

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" kf6-syntax-highlighting-devel"
fi

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	# disable failing tests
	ctest -E "testhighlighter_test|htmlhighlighter_test"
}

post_install() {
	if [ -z "$CROSS_BUILD" ]; then
		# internal tool needed for cross-building
		vinstall build/bin/katehighlightingindexer 0755 usr/libexec/kate
	fi
}

sf-syntax-highlighting-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		if [ -z "$CROSS_BUILD" ]; then
			vmove usr/libexec/kate
		fi
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
