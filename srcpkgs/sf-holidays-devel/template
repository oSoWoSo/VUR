# Template file for 'sf-holidays'
pkgname=sf-holidays
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="flex qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sonic-namespace"
makedepends="qt6-declarative-devel"
short_desc="Library to assist determining when holidays occur"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-holidays"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-holidays/archive/refs/tags/${version}.tar.gz"
checksum=3f5055523455b5dd4552f8e23fce550829187eea4764b03eea195103ecf31dd0

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-holidays-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
