hostmakedepends="gettext qt6-base qt6-tools sf-cmake-modules sf-settings sonic-namespace"
makedepends="qt6-multimedia-devel qt6-speech-devel qt6-speech-plugin-flite qt6-speech-plugin-mock qt6-speech-plugin-speechd sf-autocomplete-devel sf-settings-devel sf-settings-ui-devel sf-spell-check-devel"
