# Template file for 'sf-auth'
pkgname=sf-auth
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_LIBEXECDIR=libexec"
hostmakedepends="sonic-namespace doxygen qt6-tools qt6-base sf-cmake-modules"
makedepends="sonic-polkit-devel sf-core-addons-devel sf-windowsystem-devel"
depends="libstdc++"
checkdepends="dbus"
short_desc="Authentication and policy abstraction layer for SonicDE frameworks"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.0-only, LGPL-3.0-only"
homepage="https://github.com/Sonic-DE/sonic-frameworks-auth"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-auth/archive/refs/tags/${version}.tar.gz"
checksum=4d37317614cbc51a2c01db016c843d0240a4d400b81933e5a7491a82e1da12ae
subpackages="sf-auth-tools sf-auth-devel"

do_check() {
	cd build
	dbus-run-session ctest
}

sf-auth-tools_package() {
	short_desc+=" - tools"
	pkg_install() {
		vmove usr/libexec
		vmove "usr/lib/cmake/SF6Auth/*Tools*"
	}
}

sf-auth-devel_package() {
	depends="$makedepends sf-auth-tools>=${version}_${revision}
	 ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}
