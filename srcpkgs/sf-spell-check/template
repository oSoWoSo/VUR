# Template file for 'sf-spell-check'
pkgname=sf-spell-check
version=6.31.0
revision=1
build_style=cmake
configure_args="-DBUILD_DESIGNERPLUGIN=ON
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="sf-cmake-modules qt6-tools qt6-base qt6-declarative-host-tools sonic-namespace"
makedepends="qt6-declarative-devel aspell-devel hunspell-devel qt6-tools-devel"
short_desc="Multi-language spell checker"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-spell-check"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-spell-check/archive/refs/tags/${version}.tar.gz"
checksum=147b9384d7d381741b7323d40233d8341c34aa91c52f5f5d0c92abf45fca8f1a

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

sf-spell-check-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
		vmove usr/lib/qt6/plugins/designer
	}
}
