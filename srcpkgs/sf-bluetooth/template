# Template file for 'sf-bluetooth'
pkgname=sf-bluetooth
version=6.31.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml"
hostmakedepends="qt6-base qt6-declarative-host-tools qt6-tools sf-cmake-modules sonic-namespace"
makedepends="qt6-declarative-devel"
checkdepends="dbus"
short_desc="Qt wrapper for Bluez 5 D-Bus API"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-bluetooth"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-bluetooth/archive/refs/tags/${version}.tar.gz"
checksum=68575737ef8f2c5aa626bcdf97628590dfcb22034319b12b9a27593a04b19c11

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}

do_check() {
	cd build
	dbus-run-session ctest -E "bluezqt-managertest"
}

sf-bluetooth-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
