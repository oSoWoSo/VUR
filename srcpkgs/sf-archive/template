# Template file for 'sf-archive'
pkgname=sf-archive
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="sonic-namespace sf-cmake-modules qt6-tools qt6-base pkg-config"
makedepends="qt6-base-devel zlib-devel bzip2-devel liblzma-devel libzstd-devel"
short_desc="Qt addon providing access to numerous types of archives"
maintainer="zenobit <zen@osowoso.org>"
license="LGPL-2.1-or-later"
homepage="https://github.com/Sonic-DE/sonic-frameworks-archive"
distfiles="https://github.com/Sonic-DE/sonic-frameworks-archive/archive/refs/tags/${version}.tar.gz"
checksum=b0833f71ea7327525d5f197a750dcc1faeeb244ac33fba4222190d2ecc9d8e74

sf-archive-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}

post_patch() {
	. /usr/libexec/sonic-namespace/sonic-namespace.sh
	sonic_namespace_patch
}
